POST http://localhost:2525/imposters
Content-Type: application/json

{
  "port": 4557,
  "protocol": "http",
  "name": "Exercicio12",
  "stubs": [
    {
      "responses": [
        {
          "is": {
            "statusCode": 200,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "token": "jwt-token-xyz",
              "expires_in": 3600
            }
          }
        }
      ],
      "predicates": [
        {
          "deepEquals": {
            "body": {
              "username": "user1",
              "password": "pass1"
            }
          }
        }
      ]
    },
    {
      "responses": [
        {
          "is": {
            "statusCode": 401,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "error": "unauthorized",
              "message": "Credenciais inválidas."
            }
          }
        }
      ],
      "predicates": [
        {
          "equals": {
            "method": "POST",
            "path": "/api/auth"
          }
        }
      ]
    }
  ]
}

